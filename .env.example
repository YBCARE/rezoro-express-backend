# Neon Postgres connection string (Dashboard > Connection Details > Connection string)
DATABASE_URL=

# Resend API key, used to send shipment status update emails (Resend Dashboard > API Keys)
RESEND_API_KEY=

# Password for the /admin panel. Use a genuinely strong, random value — this is a real
# security boundary protecting write access to shipment data and the ability to send emails.
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. If unset, a random one is generated at
# startup, which means admin sessions won't survive a server restart. Set this for
# persistent sessions across deploys/restarts — any long random string works.
SESSION_SECRET=
